{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "fs:write-all",
      "allow": ["$APPLOCALDATA/**"]
    },
    {
      "identifier": "fs:read-all",
      "allow": ["$APPLOCALDATA/**"]
    }
  ]
}
