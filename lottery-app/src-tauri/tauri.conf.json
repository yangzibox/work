{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LuckyDrawBox", 
  "version": "1.0.1",
  "identifier": "com.yangzibox.luckydrawbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
	"withGlobalTauri": true,
    "windows": [
      {
        "title": "LuckyDrawBox",
        "width": 720,
        "height": 540,
        "resizable": true,
        "fullscreen": false,
        "visible": true,         
        "backgroundColor": "#b71c1c",
		"center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
	"resources": [
		"resources/configuration/settings.json",
		"resources/configuration/participants.csv"
	]
  }
}
